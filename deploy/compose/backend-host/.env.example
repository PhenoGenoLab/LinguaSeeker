# Backend host environment — copy to .env, fill in secrets, never commit.
#
# Cross-host wiring lives here. The frontend host reaches this machine on
# BACKEND_PORT; the inference services are reached from the backend
# via *_BASE_URL variables below.


# ── Image / network ──────────────────────────────────────────────────────
# Override BACKEND_IMAGE if pulling from a custom registry path.
# IMAGE_TAG selects which build to run; the GitHub Actions deploy workflow
# passes this through automatically.
BACKEND_IMAGE=lingua-seeker-backend
IMAGE_TAG=latest
BACKEND_BIND=0.0.0.0
BACKEND_PORT=8000

# ── CORS / auth ──────────────────────────────────────────────────────────
# Must include the public origin the browser sees, e.g. https://app.example.com
CORS_ORIGINS=https://app.example.com
# Shared with the frontend nginx (deploy/compose/frontend-host/.env::API_KEY).
API_KEY=change-me-to-a-long-random-string

# ── Postgres (external container) ────────────────────────────────────────
# Point at the external Postgres container; this compose file does not start
# a database service. `172.17.0.1` is the Docker bridge gateway on Linux.
POSTGRES_HOST=172.17.0.1
POSTGRES_PORT=5432
POSTGRES_DB=lingua_seeker
POSTGRES_USER=lingua_seeker
POSTGRES_PASSWORD=change-me
POSTGRES_SCHEMA=lingua_seeker

# ── Redis (external container) ───────────────────────────────────────────
REDIS_HOST=172.17.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Neo4j (external container) ───────────────────────────────────────────
NEO4J_URI=bolt://172.17.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# ── Inference service / LLM endpoints ──────────────────────────────────────
# Either remote SaaS or your GPU host. For same-host Docker containers exposed
# on the host, use host.docker.internal; for cross-host services, use private IPs.
EMBEDDING_BASE_URL=http://host.docker.internal:32949
EMBEDDING_API_STYLE=simple
RERANK_BASE_URL=http://host.docker.internal:35001
RERANK_API_STYLE=simple
TRANSLATION_LLM_LOCAL_BASE_URL=http://host.docker.internal:59062/api
TRANSLATION_LLM_LOCAL_TARGET_LANG=en
TRANSLATION_LLM_LOCAL_TIMEOUT=120
FAST_LLM_BASE_URL=https://api.siliconflow.cn/v1
REASONING_LLM_BASE_URL=https://api.siliconflow.cn/v1
REASONING_LLM_REASONING_EFFORT=high
