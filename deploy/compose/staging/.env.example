# Staging backend environment — copy to .env, fill in secrets, never commit.

# ── Image / network ──────────────────────────────────────────────────────
BACKEND_IMAGE=lingua-seeker-backend
IMAGE_TAG=latest
BACKEND_BIND=0.0.0.0
BACKEND_PORT=8000

# ── CORS / auth ──────────────────────────────────────────────────────────
CORS_ORIGINS=https://staging.example.com
API_KEY=change-me-to-a-long-random-string

# ── External database containers ─────────────────────────────────────────
# This compose file starts only the backend. Point these at the external
# Postgres/Redis/Neo4j containers.
POSTGRES_HOST=172.17.0.1
POSTGRES_PORT=5432
POSTGRES_PASSWORD=change-me
REDIS_HOST=172.17.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
NEO4J_URI=bolt://172.17.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# ── Inference service / LLM endpoints ──────────────────────────────────────
EMBEDDING_BASE_URL=http://host.docker.internal:32949
EMBEDDING_API_STYLE=openai
RERANK_BASE_URL=http://host.docker.internal:35001
RERANK_API_STYLE=openai
FAST_LLM_BASE_URL=https://api.siliconflow.cn/v1
REASONING_LLM_BASE_URL=https://api.siliconflow.cn/v1
